<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive system files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|deploy\.sh|\.cpanel\.yml) - [F,L,NC]

    # Forward all web requests to Laravel public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
